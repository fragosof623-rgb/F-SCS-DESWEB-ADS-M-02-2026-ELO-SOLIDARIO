# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o GitHub.

# Chave da API da Anthropic (Claude) — crie em https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado pelo EcoBot (opcional; padrão: claude-opus-5-5)
IA_MODELO=

# Porta do servidor local (opcional; padrão: 3000). No Railway ela é definida automaticamente.
PORT=
